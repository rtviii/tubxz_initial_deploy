NEO4J_USER=neo4j
NEO4J_PASSWORD=longerthan8chars
# Neo4j Community Edition only supports the default "neo4j" database.
# Named databases (e.g. "tubxz") require Enterprise Edition.
NEO4J_CURRENTDB=neo4j

SECRET_KEY=changeme

# Absolute path on the HOST machine for structure profile data (~4GB for ~800 structures).
# Created automatically by setup.sh if it doesn't exist.
TUBETL_DATA_HOST=/data/tubetl_data

CERTS_PATH=./nginx/certs

# Optional: restrict CORS origins (comma-separated). If empty, defaults to localhost:3000.
# Behind nginx this is typically not needed since everything is same-origin.
# CORS_ALLOWED_ORIGINS=https://tubulinxyz.institution.edu

# --- LLM translator for the search bar ---
# Provider: "anthropic" (default, direct Anthropic API) or "openai_compat"
# (OpenRouter, vLLM, or any OpenAI-compatible endpoint).
NL_TRANSLATOR_PROVIDER=openai_compat

# Set the matching key. For OpenRouter, either OPENROUTER_API_KEY or
# OPENAI_API_KEY works (both checked). For direct Anthropic, set ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. Defaults: https://openrouter.ai/api/v1 and anthropic/claude-haiku-4-5.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-haiku-4-5

# Optional attribution headers (OpenRouter shows these on their dashboard).
# OPENROUTER_REFERER=https://tubulinxyz.institution.edu
# OPENROUTER_APP_TITLE=TubulinXYZ

# --- Pinned image versions ---
# Reproducible deploys: a specific tag pinned here means ./setup.sh always
# brings up the same image. To bump versions, edit the tag and re-run setup.sh.
# To track :latest instead (not recommended for production), comment these out.
BACKEND_IMAGE=ghcr.io/rtviii/tubulinxyz:0.1.0
FRONTEND_IMAGE=ghcr.io/rtviii/tubulinxyz-frontend:0.1.0

# "missing" = only pull when the image isn't already on the host. Keeps
# ./setup.sh from hitting GHCR on every run. Use "always" only when tracking
# moving tags like :latest.
BACKEND_PULL_POLICY=missing
FRONTEND_PULL_POLICY=missing
